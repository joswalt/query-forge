{
  "name": "queryforge",
  "version": "0.1.0",
  "description": "Cross-platform desktop database query and exploration tool for Azure Cosmos DB and Azure SQL Database.",
  "main": "./out/main/index.js",
  "author": "QueryForge",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c electron-tests/playwright.config.ts",
    "typecheck:e2e": "tsc --noEmit -p electron-tests/tsconfig.json",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/msal-node": "^7.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^13.0.3",
    "mssql": "^12.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "rollup": "4.64.1"
  },
  "build": {
    "appId": "com.queryforge.app",
    "productName": "QueryForge",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    }
  }
}
