{
  "name": "queryforge",
  "version": "0.1.0",
  "description": "Cross-platform desktop database query and exploration tool for Azure Cosmos DB and Azure SQL Database.",
  "main": "./out/main/index.js",
  "author": "QueryForge",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "better-sqlite3": "^13.0.3",
    "mssql": "^12.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "rollup": "4.64.1"
  }
}
